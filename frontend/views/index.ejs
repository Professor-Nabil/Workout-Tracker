<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Workout Tracker</title>
    <style>
        body { font-family: sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }
        .form-group { margin-bottom: 15px; }
        input { width: 100%; padding: 8px; box-sizing: border-box; }
        button { padding: 10px; background: #007bff; color: white; border: none; cursor: pointer; margin-top: 10px; }
        #message { margin-top: 20px; font-weight: bold; }
    </style>
</head>
<body>
    <div id="auth-section">
        <h1>Auth</h1>
        <div class="form-group"><label>Email:</label><input type="email" id="email"></div>
        <div class="form-group"><label>Password:</label><input type="password" id="password"></div>
        <button onclick="handleAuth('/api/auth/signup')">Sign Up</button>
        <button onclick="handleAuth('/api/auth/login')">Login</button>
    </div>

    <div id="dashboard-section" style="display: none;">
        <h1>Dashboard</h1>
        <button onclick="handleLogout()">Logout</button>
        
        <hr>
        <h3>Create New Workout</h3>
        <div class="form-group"><input type="text" id="workout-title" placeholder="Workout Title"></div>
        <div class="form-group"><input type="datetime-local" id="workout-date"></div>
        <button onclick="handleCreateWorkout()">Create Workout</button>

        <h3>Your Workouts</h3>
        <div id="workout-list"></div>

        <hr>
        <h3>Log Measurement</h3>
        <div class="form-group"><input type="number" id="measurement-weight" placeholder="Weight (kg)"></div>
        <button onclick="handleLogMeasurement()">Log Weight</button>
        <div id="measurement-list"></div>

        <hr>
        <h3>Exercises</h3>
        <div id="exercise-list"></div>
    </div>

    <div id="message"></div>

    <script>
        // ... existing handleAuth, showDashboard, handleCreateWorkout, handleLogout functions ...

        async function showDashboard() {
            document.getElementById('auth-section').style.display = 'none';
            document.getElementById('dashboard-section').style.display = 'block';
            await loadWorkouts();
            await loadMeasurements();
            await loadExercises();
        }

        async function loadMeasurements() {
            const res = await fetch('/api/measurements', {
                headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
            });
            const data = await res.json();
            document.getElementById('measurement-list').innerHTML = '<pre>' + JSON.stringify(data, null, 2) + '</pre>';
        }

        async function handleLogMeasurement() {
            const weight = parseFloat(document.getElementById('measurement-weight').value);
            const res = await fetch('/api/measurements', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + localStorage.getItem('token') 
                },
                body: JSON.stringify({ weight })
            });
            if (res.ok) loadMeasurements();
        }

        async function loadExercises() {
            const res = await fetch('/api/exercises', {
                headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
            });
            const data = await res.json();
            document.getElementById('exercise-list').innerHTML = '<pre>' + JSON.stringify(data, null, 2) + '</pre>';
        }

        // ... existing handleAuth, handleCreateWorkout, handleLogout, loadWorkouts ...
    </script>
</body>
</html>
