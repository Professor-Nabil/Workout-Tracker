<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Workout Tracker</title>
    <style>
        body { font-family: sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }
        .form-group { margin-bottom: 15px; }
        input { width: 100%; padding: 8px; box-sizing: border-box; }
        button { padding: 10px; background: #007bff; color: white; border: none; cursor: pointer; margin-top: 10px; }
        #message { margin-top: 20px; font-weight: bold; }
    </style>
</head>
<body>
    <div id="auth-section">
        <h1>Auth</h1>
        <div class="form-group"><label>Email:</label><input type="email" id="email"></div>
        <div class="form-group"><label>Password:</label><input type="password" id="password"></div>
        <button onclick="handleAuth('/api/auth/signup')">Sign Up</button>
        <button onclick="handleAuth('/api/auth/login')">Login</button>
    </div>

    <div id="dashboard-section" style="display: none;">
        <h1>Dashboard</h1>
        <button onclick="handleLogout()">Logout</button>
        
        <hr>
        <h3>Create New Workout</h3>
        <div class="form-group"><input type="text" id="workout-title" placeholder="Workout Title"></div>
        <div class="form-group"><input type="datetime-local" id="workout-date"></div>
        <button onclick="handleCreateWorkout()">Create Workout</button>

        <h3>Your Workouts</h3>
        <div id="workout-list"></div>

        <hr>
        <h3>Log Measurement</h3>
        <div class="form-group"><input type="number" id="measurement-weight" placeholder="Weight (kg)"></div>
        <button onclick="handleLogMeasurement()">Log Weight</button>
        <div id="measurement-list"></div>

        <hr>
        <h3>Exercises</h3>
        <div id="exercise-list"></div>
    </div>

    <div id="workout-detail" style="display: none;">
        <button onclick="hideDetail()">Back to Dashboard</button>
        <h2 id="detail-title"></h2>
        
        <h4>Add Exercise</h4>
        <select id="new-exercise-id"></select>
        <input type="number" id="new-sequence" placeholder="Seq" style="width: 50px;">
        <button onclick="addExerciseToWorkout()">Add Exercise</button>

        <div id="detail-exercises"></div>
    </div>

    <div id="message"></div>

    <script>
        if (localStorage.getItem('token')) showDashboard();

        async function handleAuth(url) {
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });
            const data = await res.json();
            if (res.ok) {
                if (data.accessToken) localStorage.setItem('token', data.accessToken);
                showDashboard();
            } else {
                document.getElementById('message').innerText = 'Error: ' + JSON.stringify(data);
            }
        }

        function showDashboard() {
            document.getElementById('auth-section').style.display = 'none';
            document.getElementById('dashboard-section').style.display = 'block';
            loadWorkouts();
            loadMeasurements();
            loadExercises();
        }

        async function loadWorkouts() {
            const res = await fetch('/api/workouts', {
                headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
            });
            const workouts = await res.json();
            document.getElementById('workout-list').innerHTML = workouts.map(w => `
                <div style="border: 1px solid #ccc; margin: 5px; padding: 5px;">
                    ${w.title} 
                    <button onclick="loadWorkoutDetail('${w.id}')">View/Edit</button>
                </div>
            `).join('');
        }

        async function loadWorkoutDetail(id) {
            const res = await fetch('/api/workouts/' + id, {
                headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
            });
            const workout = await res.json();
            document.getElementById('dashboard-section').style.display = 'none';
            document.getElementById('workout-detail').style.display = 'block';
            document.getElementById('detail-title').innerText = workout.title;
            window.currentWorkoutId = id;
            
            const exercisesRes = await fetch('/api/exercises', {
                headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
            });
            const exercises = await exercisesRes.json();
            document.getElementById('new-exercise-id').innerHTML = exercises.map(ex => 
                `<option value="${ex.id}">${ex.name}</option>`
            ).join('');

            document.getElementById('detail-exercises').innerHTML = '<pre>' + JSON.stringify(workout.exercises, null, 2) + '</pre>';
        }

        function hideDetail() {
            document.getElementById('dashboard-section').style.display = 'block';
            document.getElementById('workout-detail').style.display = 'none';
        }

        async function addExerciseToWorkout() {
            const exerciseId = document.getElementById('new-exercise-id').value;
            const sequence = parseInt(document.getElementById('new-sequence').value);
            await fetch(`/api/workouts/${window.currentWorkoutId}/exercises`, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + localStorage.getItem('token') 
                },
                body: JSON.stringify({ exerciseId, sequence })
            });
            loadWorkoutDetail(window.currentWorkoutId);
        }

        async function loadMeasurements() {
            const res = await fetch('/api/measurements', {
                headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
            });
            const data = await res.json();
            document.getElementById('measurement-list').innerHTML = '<pre>' + JSON.stringify(data, null, 2) + '</pre>';
        }

        async function handleLogMeasurement() {
            const weight = parseFloat(document.getElementById('measurement-weight').value);
            await fetch('/api/measurements', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + localStorage.getItem('token') 
                },
                body: JSON.stringify({ weight })
            });
            loadMeasurements();
        }

        async function loadExercises() {
            const res = await fetch('/api/exercises', {
                headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
            });
            const data = await res.json();
            document.getElementById('exercise-list').innerHTML = '<pre>' + JSON.stringify(data, null, 2) + '</pre>';
        }

        function handleLogout() {
            localStorage.removeItem('token');
            location.reload();
        }
    </script>
</body>
</html>
